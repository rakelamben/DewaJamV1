# Backend Environment Variables
# Salin file ini ke .env dan isi dengan nilai yang sebenarnya.
# Jangan pernah commit file .env ke repository.

# ==============================================================================
# Database
# ==============================================================================

# URL koneksi PostgreSQL ke database Supabase.
# Format: postgresql://user:password@host:port/dbname
DATABASE_URL=postgresql://user:password@db.your-project-ref.supabase.co:5432/postgres

# ==============================================================================
# Supabase
# ==============================================================================

# URL project Supabase.
# Ditemukan di: Supabase Dashboard → Settings → API → Project URL
SUPABASE_URL=https://your-project-ref.supabase.co

# Secret untuk memverifikasi JWT yang diterbitkan Supabase Auth.
# Ditemukan di: Supabase Dashboard → Settings → API → JWT Secret
# RAHASIA — jangan pernah dikirim ke frontend atau di-commit.
SUPABASE_JWT_SECRET=your-supabase-jwt-secret
# Optional for projects using asymmetric ES256/RS256 signing keys.
# Default: ${SUPABASE_URL}/auth/v1/.well-known/jwks.json
SUPABASE_JWKS_URL=

# Service role key Supabase (hak akses penuh, melewati RLS).
# Ditemukan di: Supabase Dashboard → Settings → API → service_role key
# RAHASIA — hanya untuk backend. Jangan pernah dikirim ke frontend atau di-commit.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ==============================================================================
# CORS dan Lingkungan
# ==============================================================================

# Daftar origin yang diizinkan untuk CORS, dipisahkan koma.
# Contoh production: https://dewajam.example.com
ALLOWED_ORIGINS=http://localhost:5173

# Lingkungan saat ini. Nilai umum: development, staging, production
ENVIRONMENT=development
